# Copier ce fichier en .env et l'adapter (ne jamais commiter .env)

# --- Application ---
APP_ENV=development

# --- Ports ---
# Port interne du conteneur FastAPI
BACKEND_PORT=8000
# Port exposé sur la machine : à changer si 8000 est déjà pris
BACKEND_HOST_PORT=8000

